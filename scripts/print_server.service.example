# Example systemd service for print_server.py
# Copy to /etc/systemd/system/print_server.service and edit paths as needed
[Unit]
Description=TiendaVideojuegos print server
After=network.target

[Service]
Type=simple
User=youruser
WorkingDirectory=/path/to/TiendaVideojuegos
ExecStart=/path/to/TiendaVideojuegos/.venv/bin/python /path/to/TiendaVideojuegos/print_server.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
